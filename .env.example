# Copy to `.env` and fill in. All three are required (the app throws on startup otherwise).

# Supabase project — Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# PowerSync instance URL — PowerSync dashboard → your instance → "Instance URL"
VITE_POWERSYNC_URL=https://YOUR-INSTANCE.journeyapps.com
