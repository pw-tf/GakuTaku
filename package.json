    "@capacitor/local-notifications": "^7.0.7",
    "@capacitor/share": "^7.0.4",
    "@fontsource/hanken-grotesk": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "@sglkc/kuromoji": "^1.1.0",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@zip.js/zip.js": "^2.23.0",
    "comlink": "^4.4.2",
    "dexie": "^4.4.3",
    "epubjs": "^0.3.93",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.14"
